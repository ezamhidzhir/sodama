# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # backend only — never expose to frontend
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY    # safe for frontend

# Storage
AUDIO_BUCKET=audio-files
